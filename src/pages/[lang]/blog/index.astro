---
/**
 * Blog index for each non-default locale (e.g. /en/blog/).
 */
import BlogIndexView from '@/views/BlogIndexView.astro';
import { getLocalizedStaticPaths, type Locale } from '@/i18n';

export const prerender = true;

export function getStaticPaths() {
  return getLocalizedStaticPaths('blog', null);
}

const { locale } = Astro.props as { locale: Locale };
---

<BlogIndexView locale={locale} />
