---
/**
 * Home page for non-default locales (e.g. /en/).
 */
import HomeView from '@/views/HomeView.astro';
import { getLocalizedStaticPaths, type Locale } from '@/i18n';

export const prerender = true;

export function getStaticPaths() {
  return getLocalizedStaticPaths('home', null);
}

const { locale } = Astro.props as { locale: Locale };
---

<HomeView locale={locale} />
