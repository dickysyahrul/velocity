---
/** About page for each non-default locale (currently /en/about/). */
import AboutView from '@/views/AboutView.astro';
import { getLocalizedStaticPaths, type Locale } from '@/i18n';

export function getStaticPaths() {
  return getLocalizedStaticPaths('about', 'about');
}

// Derive the locale from the actual URL segment to avoid rendering translated
// routes using the default locale when page props are stale or misconfigured.
const locale = Astro.params.lang as Locale;
---

<AboutView locale={locale} />
