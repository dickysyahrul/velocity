---
/** Search page for each non-default locale (currently /en/search/). */
import SearchView from '@/views/SearchView.astro';
import { getLocalizedStaticPaths, type Locale } from '@/i18n';

export function getStaticPaths() {
  return getLocalizedStaticPaths('search', 'search');
}

const locale = Astro.params.lang as Locale;
---

<SearchView locale={locale} />
